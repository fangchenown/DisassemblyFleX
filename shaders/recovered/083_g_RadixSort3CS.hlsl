        r0.z = asuint(r0.y >> (cb0[0].w & 31u));
        // and r0.z, r0.z, l(0x0000000f)
        r0.z = (r0.z & 0x0000000fu);
        // ld_structured r0.w, r0.z, l(0x00000000), g5.xxxx
        r0.w = g5[r0.z].w[(0x00000000u) / 4u + 0u];
        // iadd r0.w, -r0.w, r0.x
        r0.w = ((-(r0.w)) + r0.x);
        // ld_structured r0.z, r0.z, l(0x00000000), g4.xxxx
        r0.z = g4[r0.z].w[(0x00000000u) / 4u + 0u];
        // iadd r0.z, r0.z, r0.w
        r0.z = (r0.z + r0.w);
        // store_uav_typed u0.xyzw, r0.zzzz, r0.yyyy
        u0_keyDst[r0.z] = uint4(r0.y, r0.y, r0.y, r0.y);
        // ld_structured r0.y, r0.x, l(0x00000000), g1.xxxx
        r0.y = g1[r0.x].w[(0x00000000u) / 4u + 0u];
        // store_uav_typed u1.xyzw, r0.zzzz, r0.yyyy
        u1_valDst[r0.z] = uint4(r0.y, r0.y, r0.y, r0.y);
        // iadd r0.x, r0.x, l(0x00000100)
        r0.x = (r0.x + 0x00000100u);
        // endloop
    }
    // ret
    return;
}
