        u0_SolveSprings__deltas.Store((r0.x) + 0u, r1.x);
        u0_SolveSprings__deltas.Store((r0.x) + 4u, r1.y);
        u0_SolveSprings__deltas.Store((r0.x) + 8u, r1.z);
        u0_SolveSprings__deltas.Store((r0.x) + 12u, r1.w);
        // endif
    }
    // ret
    return;
}
