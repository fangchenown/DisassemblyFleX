            // mul r0.z, r2.z, r3.x
            r0.z = asuint((asfloat(r2.z) * asfloat(r3.x)));
            // mad r4.z, r3.w, r2.y, -r0.z
            r4.z = asuint(mad(asfloat(r3.w), asfloat(r2.y), (-(asfloat(r0.z)))));
            // dp3 r0.z, r1.xzwx, r4.xyzx
            r0.z = asuint(dot(float3(asfloat(r1.x), asfloat(r1.z), asfloat(r1.w)), float3(asfloat(r4.x), asfloat(r4.y), asfloat(r4.z))));
            // else
        } else {
            // mov r0.z, l(0x00000000)
            r0.z = 0x00000000u;
            // endif
        }
        // store_structured g3.x, vThreadIDInGroup.x, l(0x00000000), r0.z
        g3[vThreadIDInGroup.x].w[(0x00000000u) / 4u + 0u] = r0.z;
        // ushr r0.z, r0.w, l(0x00000001)
        r0.z = asuint(r0.w >> (0x00000001u & 31u));
        // mov r0.w, r0.z
        r0.w = r0.z;
        // loop
        [loop] while (true) {
            // uge r1.x, l(0x00000000), r0.w
            r1.x = (0x00000000u >= r0.w ? 0xffffffffu : 0u);
            // breakc_nz r1.x
            if (r1.x != 0u) break;
            // sync_g_t
            GroupMemoryBarrierWithGroupSync();
            // ult r1.x, vThreadIDInGroup.x, r0.w
            r1.x = (vThreadIDInGroup.x < r0.w ? 0xffffffffu : 0u);
            // if_nz r1.x
            if (r1.x != 0u) {
                // iadd r1.x, r0.w, vThreadIDInGroup.x
                r1.x = (r0.w + vThreadIDInGroup.x);
                // ld_structured r1.y, vThreadIDInGroup.x, l(0x00000000), g3.xxxx
                r1.y = g3[vThreadIDInGroup.x].w[(0x00000000u) / 4u + 0u];
                // ld_structured r1.x, r1.x, l(0x00000000), g3.xxxx
                r1.x = g3[r1.x].w[(0x00000000u) / 4u + 0u];
                // add r1.x, r1.x, r1.y
                r1.x = asuint((asfloat(r1.x) + asfloat(r1.y)));
                // store_structured g3.x, vThreadIDInGroup.x, l(0x00000000), r1.x
                g3[vThreadIDInGroup.x].w[(0x00000000u) / 4u + 0u] = r1.x;
                // endif
            }
            // ushr r0.w, r0.w, l(0x00000001)
            r0.w = asuint(r0.w >> (0x00000001u & 31u));
            // endloop
        }
        // sync_g_t
        GroupMemoryBarrierWithGroupSync();
        // ld_structured r0.z, l(0x00000000), l(0x00000000), g3.xxxx
        r0.z = g3[0x00000000u].w[(0x00000000u) / 4u + 0u];
        // if_z vThreadIDInGroup.x
        if (vThreadIDInGroup.x == 0u) {
            // ld_raw r0.w, l(0x00000000), g1.xxxx
            r0.w = g1[(0x00000000u) / 4u + 0u];
            // add r0.z, r0.z, r0.w
            r0.z = asuint((asfloat(r0.z) + asfloat(r0.w)));
            // store_raw g1.x, l(0x00000000), r0.z
            g1[(0x00000000u) / 4u + 0u] = r0.z;
            // endif
        }
        // sync_g_t
        GroupMemoryBarrierWithGroupSync();
        // iadd r0.x, r0.x, l(0x00000001)
        r0.x = (r0.x + 0x00000001u);
        // endloop
    }
    // if_z vThreadIDInGroup.x
    if (vThreadIDInGroup.x == 0u) {
        // ld_raw r0.xy, l(0x00000008), g0.xyxx
        r0.xy = uint2(g0[(0x00000008u) / 4u + 0u], g0[(0x00000008u) / 4u + 1u]);
        // mul r0.x, r0.x, l(0x3c23d70a)
        r0.x = asuint((asfloat(r0.x) * asfloat(0x3c23d70au)));
        // ld_raw r0.z, l(0x00000008), g0.xxxx
        r0.z = g0[(0x00000008u) / 4u + 0u];
        // ld_raw r0.w, l(0x00000000), g1.xxxx
        r0.w = g1[(0x00000000u) / 4u + 0u];
        // max r0.x, |r0.x|, |r0.w|
        r0.x = asuint(max(abs(asfloat(r0.x)), abs(asfloat(r0.w))));
        // div r0.x, |r0.z|, r0.x
        r0.x = asuint((abs(asfloat(r0.z)) / asfloat(r0.x)));
        // mul r1.x, r0.x, r0.x
        r1.x = asuint((asfloat(r0.x) * asfloat(r0.x)));
        // mul r0.x, r0.x, r1.x
        r0.x = asuint((asfloat(r0.x) * asfloat(r1.x)));
        // add r0.z, -r0.z, r0.w
        r0.z = asuint(((-(asfloat(r0.z))) + asfloat(r0.w)));
        // mul r0.y, r0.y, r0.z
        r0.y = asuint((asfloat(r0.y) * asfloat(r0.z)));
        // mul r0.x, r0.x, r0.y
        r0.x = asuint((asfloat(r0.x) * asfloat(r0.y)));
        // store_structured u0.x, vThreadGroupID.x, l(0x00000000), r0.x
        u0_CalculateInflatableVolume__lambdas[vThreadGroupID.x].w[(0x00000000u) / 4u + 0u] = r0.x;
        // endif
    }
    // ret
    return;
}
