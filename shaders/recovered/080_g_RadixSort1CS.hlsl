        // imad r4.xyz, r0.xywx, cb0[0].xxxx, vThreadGroupID.xxxx
        r4.xyz = uint3((r0.x * cb0[0].x + vThreadGroupID.x), (r0.y * cb0[0].x + vThreadGroupID.x), (r0.w * cb0[0].x + vThreadGroupID.x));
        // store_uav_typed u0.xyzw, r4.xxxx, r1.zzzz
        u0_counters[r4.x] = uint4(r1.z, r1.z, r1.z, r1.z);
        // store_uav_typed u0.xyzw, r4.yyyy, r2.wwww
        u0_counters[r4.y] = uint4(r2.w, r2.w, r2.w, r2.w);
        // store_uav_typed u0.xyzw, r4.zzzz, r1.wwww
        u0_counters[r4.z] = uint4(r1.w, r1.w, r1.w, r1.w);
        // iadd r4.x, vThreadGroupID.x, cb0[0].x
        r4.x = (vThreadGroupID.x + cb0[0].x);
        // bfi r0.z, l(0x0000001c), l(0x00000004), r4.x, r0.z
        r0.z = recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r0.z);
        // store_uav_typed u0.xyzw, r0.zzzz, r2.xxxx
        u0_counters[r0.z] = uint4(r2.x, r2.x, r2.x, r2.x);
        // bfi r3.xyzw, l(0x0000001c, 0x0000001c, 0x0000001c, 0x0000001c), l(0x00000004, 0x00000004, 0x00000004, 0x00000004), r4.xxxx, r3.xyzw
        r3.xyzw = uint4(recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r3.x), recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r3.y), recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r3.z), recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r3.w));
        // store_uav_typed u0.xyzw, r3.xxxx, r1.xxxx
        u0_counters[r3.x] = uint4(r1.x, r1.x, r1.x, r1.x);
        // store_uav_typed u0.xyzw, r3.yyyy, r2.yyyy
        u0_counters[r3.y] = uint4(r2.y, r2.y, r2.y, r2.y);
        // store_uav_typed u0.xyzw, r3.zzzz, r1.yyyy
        u0_counters[r3.z] = uint4(r1.y, r1.y, r1.y, r1.y);
        // store_uav_typed u0.xyzw, r3.wwww, r2.zzzz
        u0_counters[r3.w] = uint4(r2.z, r2.z, r2.z, r2.z);
        // bfi r0.xyz, l(0x0000001c, 0x0000001c, 0x0000001c, 0x00000000), l(0x00000004, 0x00000004, 0x00000004, 0x00000000), r4.xxxx, r0.xywx
        r0.xyz = uint3(recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r0.x), recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r0.y), recovered_bfi(0x0000001cu, 0x00000004u, r4.x, r0.w));
        // store_uav_typed u0.xyzw, r0.xxxx, r1.zzzz
        u0_counters[r0.x] = uint4(r1.z, r1.z, r1.z, r1.z);
        // store_uav_typed u0.xyzw, r0.yyyy, r2.wwww
        u0_counters[r0.y] = uint4(r2.w, r2.w, r2.w, r2.w);
        // store_uav_typed u0.xyzw, r0.zzzz, r1.wwww
        u0_counters[r0.z] = uint4(r1.w, r1.w, r1.w, r1.w);
        // endif
    }
    // ret
    return;
}
