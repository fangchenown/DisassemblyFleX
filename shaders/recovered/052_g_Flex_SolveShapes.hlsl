                u0_InterlockedFloat__accum.InterlockedCompareExchange(r3.y, r6.y, r6.x, _atomic2);
                r7.y = _atomic2;
                // ieq r4.x, r6.y, r7.y
                r4.x = (r6.y == r7.y ? 0xffffffffu : 0u);
                // if_nz r4.x
                if (r4.x != 0u) {
                    // break
                    break;
                    // endif
                }
                // mad r7.x, -r4.y, r0.w, r7.y
                r7.x = asuint(mad((-(asfloat(r4.y))), asfloat(r0.w), asfloat(r7.y)));
                // mov r6.xy, r7.xyxx
                r6.xy = uint2(r7.x, r7.y);
                // endloop
            }
            // mov r4.x, r5.z
            r4.x = r5.z;
            // mov r4.y, l(0x00000000)
            r4.y = 0x00000000u;
            // loop
            [loop] while (true) {
                // imm_atomic_cmp_exch r6.y, u0, r3.z, r4.y, r4.x
                uint _atomic3;
                u0_InterlockedFloat__accum.InterlockedCompareExchange(r3.z, r4.y, r4.x, _atomic3);
                r6.y = _atomic3;
                // ieq r3.y, r4.y, r6.y
                r3.y = (r4.y == r6.y ? 0xffffffffu : 0u);
                // if_nz r3.y
                if (r3.y != 0u) {
                    // break
                    break;
                    // endif
                }
                // mad r6.x, -r4.z, r0.w, r6.y
                r6.x = asuint(mad((-(asfloat(r4.z))), asfloat(r0.w), asfloat(r6.y)));
                // mov r4.xy, r6.xyxx
                r4.xy = uint2(r6.x, r6.y);
                // endloop
            }
            // mov r3.yz, l(0x00000000,0x3f800000,0x00000000,0x00000000)
            r3.yz = uint2(0x3f800000u, 0x00000000u);
            // loop
            [loop] while (true) {
                // imm_atomic_cmp_exch r4.x, u0, r3.w, r3.z, r3.y
                uint _atomic4;
                u0_InterlockedFloat__accum.InterlockedCompareExchange(r3.w, r3.z, r3.y, _atomic4);
                r4.x = _atomic4;
                // ieq r4.z, r3.z, r4.x
                r4.z = (r3.z == r4.x ? 0xffffffffu : 0u);
                // if_nz r4.z
                if (r4.z != 0u) {
                    // break
                    break;
                    // endif
                }
                // add r4.y, r4.x, l(0x3f800000)
                r4.y = asuint((asfloat(r4.x) + asfloat(0x3f800000u)));
                // mov r3.yz, r4.yyxy
                r3.yz = uint2(r4.y, r4.x);
                // endloop
            }
            // endif
        }
        // iadd r3.x, r3.x, l(0x00000001)
        r3.x = (r3.x + 0x00000001u);
        // endloop
    }
    // ret
    return;
}
