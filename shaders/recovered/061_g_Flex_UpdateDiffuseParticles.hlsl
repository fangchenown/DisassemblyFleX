        // movc r0.xy, r1.wwww, r3.zwzz, r0.yzyy
        r0.xy = uint2((r1.w != 0u ? r3.z : r0.y), (r1.w != 0u ? r3.w : r0.z));
        // mov r3.xyz, r2.xyzx
        r3.xyz = uint3(r2.x, r2.y, r2.z);
        // mov r4.x, r2.w
        r4.x = r2.w;
        // mov r4.yz, r0.xxyx
        r4.yz = uint2(r0.x, r0.y);
        // mov r0.z, l(0x00000000)
        r0.z = 0x00000000u;
        // loop
        [loop] while (true) {
            // ige r1.w, r0.z, cb0[8].x
            r1.w = (asint(r0.z) >= asint(cb0[8].x) ? 0xffffffffu : 0u);
            // breakc_nz r1.w
            if (r1.w != 0u) break;
            // dp3 r1.w, r4.xyzx, cb0[r0.z + 0].xyzx
            r1.w = asuint(dot(float3(asfloat(r4.x), asfloat(r4.y), asfloat(r4.z)), float3(asfloat(cb0[r0.z + 0].x), asfloat(cb0[r0.z + 0].y), asfloat(cb0[r0.z + 0].z))));
            // add r1.w, r1.w, cb0[r0.z + 0].w
            r1.w = asuint((asfloat(r1.w) + asfloat(cb0[r0.z + 0].w)));
            // add r1.w, r1.w, -cb0[18].z
            r1.w = asuint((asfloat(r1.w) + (-(asfloat(cb0[18].z)))));
            // ge r5.x, l(0x00000000), r1.w
            r5.x = (asfloat(0x00000000u) >= asfloat(r1.w) ? 0xffffffffu : 0u);
            // mad r5.yzw, -r1.wwww, cb0[r0.z + 0].xxyz, r4.xxyz
            r5.yzw = uint3(asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].x), asfloat(r4.x))), asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].y), asfloat(r4.y))), asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].z), asfloat(r4.z))));
            // dp3 r1.w, r1.xyzx, cb0[r0.z + 0].xyzx
            r1.w = asuint(dot(float3(asfloat(r1.x), asfloat(r1.y), asfloat(r1.z)), float3(asfloat(cb0[r0.z + 0].x), asfloat(cb0[r0.z + 0].y), asfloat(cb0[r0.z + 0].z))));
            // lt r6.x, r1.w, l(0x00000000)
            r6.x = (asfloat(r1.w) < asfloat(0x00000000u) ? 0xffffffffu : 0u);
            // mul r1.w, r1.w, l(0x3fc00000)
            r1.w = asuint((asfloat(r1.w) * asfloat(0x3fc00000u)));
            // mad r6.yzw, -r1.wwww, cb0[r0.z + 0].xxyz, r3.xxyz
            r6.yzw = uint3(asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].x), asfloat(r3.x))), asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].y), asfloat(r3.y))), asuint(mad((-(asfloat(r1.w))), asfloat(cb0[r0.z + 0].z), asfloat(r3.z))));
            // movc r6.xyz, r6.xxxx, r6.yzwy, r3.xyzx
            r6.xyz = uint3((r6.x != 0u ? r6.y : r3.x), (r6.x != 0u ? r6.z : r3.y), (r6.x != 0u ? r6.w : r3.z));
            // movc r3.xyz, r5.xxxx, r6.xyzx, r3.xyzx
            r3.xyz = uint3((r5.x != 0u ? r6.x : r3.x), (r5.x != 0u ? r6.y : r3.y), (r5.x != 0u ? r6.z : r3.z));
            // movc r4.xyz, r5.xxxx, r5.yzwy, r4.xyzx
            r4.xyz = uint3((r5.x != 0u ? r5.y : r4.x), (r5.x != 0u ? r5.z : r4.y), (r5.x != 0u ? r5.w : r4.z));
            // iadd r0.z, r0.z, l(0x00000001)
            r0.z = (r0.z + 0x00000001u);
            // endloop
        }
        // mov r3.w, l(0x00000000)
        r3.w = 0x00000000u;
        // store_structured u1.xyzw, vThreadID.x, l(0x00000000), r3.xyzw
        u1_UpdateDiffuseParticles__diffuseVelocities[vThreadID.x].w[(0x00000000u) / 4u + 0u] = r3.x;
        u1_UpdateDiffuseParticles__diffuseVelocities[vThreadID.x].w[(0x00000000u) / 4u + 1u] = r3.y;
        u1_UpdateDiffuseParticles__diffuseVelocities[vThreadID.x].w[(0x00000000u) / 4u + 2u] = r3.z;
        u1_UpdateDiffuseParticles__diffuseVelocities[vThreadID.x].w[(0x00000000u) / 4u + 3u] = r3.w;
        // add r4.w, r0.w, -cb0[27].z
        r4.w = asuint((asfloat(r0.w) + (-(asfloat(cb0[27].z)))));
        // store_structured u0.xyzw, vThreadID.x, l(0x00000000), r4.xyzw
        u0_UpdateDiffuseParticles__diffusePositions[vThreadID.x].w[(0x00000000u) / 4u + 0u] = r4.x;
        u0_UpdateDiffuseParticles__diffusePositions[vThreadID.x].w[(0x00000000u) / 4u + 1u] = r4.y;
        u0_UpdateDiffuseParticles__diffusePositions[vThreadID.x].w[(0x00000000u) / 4u + 2u] = r4.z;
        u0_UpdateDiffuseParticles__diffusePositions[vThreadID.x].w[(0x00000000u) / 4u + 3u] = r4.w;
        // endif
    }
    // ret
    return;
}
