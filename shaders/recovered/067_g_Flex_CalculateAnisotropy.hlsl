            // endloop
        }
        // sqrt r0.x, r1.y
        r0.x = asuint(sqrt(asfloat(r1.y)));
        // sqrt r0.yz, r12.yyzy
        r0.yz = uint2(asuint(sqrt(asfloat(r12.y))), asuint(sqrt(asfloat(r12.z))));
        // mul r0.xyz, r0.xyzx, cb0[13].yyyy
        r0.xyz = uint3(asuint((asfloat(r0.x) * asfloat(cb0[13].y))), asuint((asfloat(r0.y) * asfloat(cb0[13].y))), asuint((asfloat(r0.z) * asfloat(cb0[13].y))));
        // max r0.xyz, r0.xyzx, cb0[13].zzzz
        r0.xyz = uint3(asuint(max(asfloat(r0.x), asfloat(cb0[13].z))), asuint(max(asfloat(r0.y), asfloat(cb0[13].z))), asuint(max(asfloat(r0.z), asfloat(cb0[13].z))));
        // min r0.xyz, r0.xyzx, cb0[13].wwww
        r0.xyz = uint3(asuint(min(asfloat(r0.x), asfloat(cb0[13].w))), asuint(min(asfloat(r0.y), asfloat(cb0[13].w))), asuint(min(asfloat(r0.z), asfloat(cb0[13].w))));
        // mov r8.w, r0.x
        r8.w = r0.x;
        // store_structured u0.xyzw, r2.x, l(0x00000000), r8.xyzw
        u0_CalculateAnisotropy__q1[r2.x].w[(0x00000000u) / 4u + 0u] = r8.x;
        u0_CalculateAnisotropy__q1[r2.x].w[(0x00000000u) / 4u + 1u] = r8.y;
        u0_CalculateAnisotropy__q1[r2.x].w[(0x00000000u) / 4u + 2u] = r8.z;
        u0_CalculateAnisotropy__q1[r2.x].w[(0x00000000u) / 4u + 3u] = r8.w;
        // mov r9.w, r0.y
        r9.w = r0.y;
        // store_structured u1.xyzw, r2.x, l(0x00000000), r9.xyzw
        u1_CalculateAnisotropy__q2[r2.x].w[(0x00000000u) / 4u + 0u] = r9.x;
        u1_CalculateAnisotropy__q2[r2.x].w[(0x00000000u) / 4u + 1u] = r9.y;
        u1_CalculateAnisotropy__q2[r2.x].w[(0x00000000u) / 4u + 2u] = r9.z;
        u1_CalculateAnisotropy__q2[r2.x].w[(0x00000000u) / 4u + 3u] = r9.w;
        // mov r10.w, r0.z
        r10.w = r0.z;
        // store_structured u2.xyzw, r2.x, l(0x00000000), r10.xyzw
        u2_CalculateAnisotropy__q3[r2.x].w[(0x00000000u) / 4u + 0u] = r10.x;
        u2_CalculateAnisotropy__q3[r2.x].w[(0x00000000u) / 4u + 1u] = r10.y;
        u2_CalculateAnisotropy__q3[r2.x].w[(0x00000000u) / 4u + 2u] = r10.z;
        u2_CalculateAnisotropy__q3[r2.x].w[(0x00000000u) / 4u + 3u] = r10.w;
        // endif
    }
    // ret
    return;
}
