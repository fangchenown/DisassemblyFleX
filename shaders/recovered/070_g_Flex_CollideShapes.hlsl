                                                        r4.w = asuint(dot(float3(asfloat(r16.x), asfloat(r16.y), asfloat(r16.z)), float3(asfloat(r16.x), asfloat(r16.y), asfloat(r16.z))));
                                                        // lt r5.w, l(0x00000000), r4.w
                                                        r5.w = (asfloat(0x00000000u) < asfloat(r4.w) ? 0xffffffffu : 0u);
                                                        // if_nz r5.w
                                                        if (r5.w != 0u) {
                                                            // ilt r5.w, r6.z, r3.w
                                                            r5.w = (asint(r6.z) < asint(r3.w) ? 0xffffffffu : 0u);
                                                            // if_nz r5.w
                                                            if (r5.w != 0u) {
                                                                // mul r10.xyz, r18.xxxx, r21.xyzx
                                                                r10.xyz = uint3(asuint((asfloat(r18.x) * asfloat(r21.x))), asuint((asfloat(r18.x) * asfloat(r21.y))), asuint((asfloat(r18.x) * asfloat(r21.z))));
                                                                // rsq r4.w, r4.w
                                                                r4.w = asuint(rsqrt(asfloat(r4.w)));
                                                                // mul r16.xyz, r4.wwww, r16.xyzx
                                                                r16.xyz = uint3(asuint((asfloat(r4.w) * asfloat(r16.x))), asuint((asfloat(r4.w) * asfloat(r16.y))), asuint((asfloat(r4.w) * asfloat(r16.z))));
                                                                // dp3 r4.w, r10.xyzx, r16.xyzx
                                                                r4.w = asuint(dot(float3(asfloat(r10.x), asfloat(r10.y), asfloat(r10.z)), float3(asfloat(r16.x), asfloat(r16.y), asfloat(r16.z))));
                                                                // mad r4.w, r18.x, r6.w, -r4.w
                                                                r4.w = asuint(mad(asfloat(r18.x), asfloat(r6.w), (-(asfloat(r4.w)))));
                                                                // mul r11.xw, r10.yyyz, r20.zzzx
                                                                r11.xw = uint2(asuint((asfloat(r10.y) * asfloat(r20.z))), asuint((asfloat(r10.z) * asfloat(r20.x))));
                                                                // mad r18.xy, r20.yzyy, r10.zxzz, -r11.xwxx
                                                                r18.xy = uint2(asuint(mad(asfloat(r20.y), asfloat(r10.z), (-(asfloat(r11.x))))), asuint(mad(asfloat(r20.z), asfloat(r10.x), (-(asfloat(r11.w))))));
                                                                // mul r5.w, r10.x, r20.y
                                                                r5.w = asuint((asfloat(r10.x) * asfloat(r20.y)));
                                                                // mad r18.z, r20.x, r10.y, -r5.w
                                                                r18.z = asuint(mad(asfloat(r20.x), asfloat(r10.y), (-(asfloat(r5.w)))));
                                                                // mul r18.xyz, r20.wwww, r18.xyzx
                                                                r18.xyz = uint3(asuint((asfloat(r20.w) * asfloat(r18.x))), asuint((asfloat(r20.w) * asfloat(r18.y))), asuint((asfloat(r20.w) * asfloat(r18.z))));
                                                                // add r18.xyz, r18.xyzx, r18.xyzx
                                                                r18.xyz = uint3(asuint((asfloat(r18.x) + asfloat(r18.x))), asuint((asfloat(r18.y) + asfloat(r18.y))), asuint((asfloat(r18.z) + asfloat(r18.z))));
                                                                // mad r18.xyz, r10.xyzx, r14.wwww, r18.xyzx
                                                                r18.xyz = uint3(asuint(mad(asfloat(r10.x), asfloat(r14.w), asfloat(r18.x))), asuint(mad(asfloat(r10.y), asfloat(r14.w), asfloat(r18.y))), asuint(mad(asfloat(r10.z), asfloat(r14.w), asfloat(r18.z))));
                                                                // dp3 r5.w, r20.xyzx, r10.xyzx
                                                                r5.w = asuint(dot(float3(asfloat(r20.x), asfloat(r20.y), asfloat(r20.z)), float3(asfloat(r10.x), asfloat(r10.y), asfloat(r10.z))));
                                                                // mul r10.xyz, r5.wwww, r20.xyzx
                                                                r10.xyz = uint3(asuint((asfloat(r5.w) * asfloat(r20.x))), asuint((asfloat(r5.w) * asfloat(r20.y))), asuint((asfloat(r5.w) * asfloat(r20.z))));
                                                                // mad r10.xyz, r10.xyzx, l(0x40000000, 0x40000000, 0x40000000, 0x00000000), r18.xyzx
                                                                r10.xyz = uint3(asuint(mad(asfloat(r10.x), asfloat(0x40000000u), asfloat(r18.x))), asuint(mad(asfloat(r10.y), asfloat(0x40000000u), asfloat(r18.y))), asuint(mad(asfloat(r10.z), asfloat(0x40000000u), asfloat(r18.z))));
                                                                // add r10.xyz, r19.xyzx, r10.xyzx
                                                                r10.xyz = uint3(asuint((asfloat(r19.x) + asfloat(r10.x))), asuint((asfloat(r19.y) + asfloat(r10.y))), asuint((asfloat(r19.z) + asfloat(r10.z))));
                                                                // add r18.xyz, r0.xyzx, -r10.xyzx
                                                                r18.xyz = uint3(asuint((asfloat(r0.x) + (-(asfloat(r10.x))))), asuint((asfloat(r0.y) + (-(asfloat(r10.y))))), asuint((asfloat(r0.z) + (-(asfloat(r10.z))))));
                                                                // imad r5.w, vThreadID.x, r3.w, r6.z
                                                                r5.w = (vThreadID.x * r3.w + r6.z);
                                                                // mul r10.xy, r16.yzyy, r17.zxzz
                                                                r10.xy = uint2(asuint((asfloat(r16.y) * asfloat(r17.z))), asuint((asfloat(r16.z) * asfloat(r17.x))));
                                                                // mad r10.xy, r17.yzyy, r16.zxzz, -r10.xyxx
                                                                r10.xy = uint2(asuint(mad(asfloat(r17.y), asfloat(r16.z), (-(asfloat(r10.x))))), asuint(mad(asfloat(r17.z), asfloat(r16.x), (-(asfloat(r10.y))))));
                                                                // mul r6.w, r16.x, r17.y
                                                                r6.w = asuint((asfloat(r16.x) * asfloat(r17.y)));
                                                                // mad r10.z, r17.x, r16.y, -r6.w
                                                                r10.z = asuint(mad(asfloat(r17.x), asfloat(r16.y), (-(asfloat(r6.w)))));
                                                                // mul r10.xyz, r17.wwww, r10.xyzx
                                                                r10.xyz = uint3(asuint((asfloat(r17.w) * asfloat(r10.x))), asuint((asfloat(r17.w) * asfloat(r10.y))), asuint((asfloat(r17.w) * asfloat(r10.z))));
                                                                // add r10.xyz, r10.xyzx, r10.xyzx
                                                                r10.xyz = uint3(asuint((asfloat(r10.x) + asfloat(r10.x))), asuint((asfloat(r10.y) + asfloat(r10.y))), asuint((asfloat(r10.z) + asfloat(r10.z))));
                                                                // mad r10.xyz, r16.xyzx, r12.wwww, r10.xyzx
                                                                r10.xyz = uint3(asuint(mad(asfloat(r16.x), asfloat(r12.w), asfloat(r10.x))), asuint(mad(asfloat(r16.y), asfloat(r12.w), asfloat(r10.y))), asuint(mad(asfloat(r16.z), asfloat(r12.w), asfloat(r10.z))));
                                                                // dp3 r6.w, r17.xyzx, r16.xyzx
                                                                r6.w = asuint(dot(float3(asfloat(r17.x), asfloat(r17.y), asfloat(r17.z)), float3(asfloat(r16.x), asfloat(r16.y), asfloat(r16.z))));
                                                                // mul r12.xyw, r6.wwww, r17.xyxz
                                                                r12.xyw = uint3(asuint((asfloat(r6.w) * asfloat(r17.x))), asuint((asfloat(r6.w) * asfloat(r17.y))), asuint((asfloat(r6.w) * asfloat(r17.z))));
                                                                // mad r17.xyz, r12.xywx, l(0x40000000, 0x40000000, 0x40000000, 0x00000000), r10.xyzx
                                                                r17.xyz = uint3(asuint(mad(asfloat(r12.x), asfloat(0x40000000u), asfloat(r10.x))), asuint(mad(asfloat(r12.y), asfloat(0x40000000u), asfloat(r10.y))), asuint(mad(asfloat(r12.w), asfloat(0x40000000u), asfloat(r10.z))));
                                                                // dp3 r6.w, r17.xyzx, r15.yzwy
                                                                r6.w = asuint(dot(float3(asfloat(r17.x), asfloat(r17.y), asfloat(r17.z)), float3(asfloat(r15.y), asfloat(r15.z), asfloat(r15.w))));
                                                                // add r17.w, r4.w, -r6.w
                                                                r17.w = asuint((asfloat(r4.w) + (-(asfloat(r6.w)))));
                                                                // and r4.w, r9.y, l(0x00000010)
                                                                r4.w = (r9.y & 0x00000010u);
                                                                // movc r17.xyzw, r4.wwww, l(0x00000000,0x00000000,0x00000000,0x00000000), r17.xyzw
                                                                r17.xyzw = uint4((r4.w != 0u ? 0x00000000u : r17.x), (r4.w != 0u ? 0x00000000u : r17.y), (r4.w != 0u ? 0x00000000u : r17.z), (r4.w != 0u ? 0x00000000u : r17.w));
                                                                // store_structured u1.xyzw, r5.w, l(0x00000000), r17.xyzw
                                                                u1_CollideShapes__collisionPlanes[r5.w].w[(0x00000000u) / 4u + 0u] = r17.x;
                                                                u1_CollideShapes__collisionPlanes[r5.w].w[(0x00000000u) / 4u + 1u] = r17.y;
                                                                u1_CollideShapes__collisionPlanes[r5.w].w[(0x00000000u) / 4u + 2u] = r17.z;
                                                                u1_CollideShapes__collisionPlanes[r5.w].w[(0x00000000u) / 4u + 3u] = r17.w;
                                                                // itof r18.w, r15.x
                                                                r18.w = asuint((float)asint(r15.x));
                                                                // store_structured u2.xyzw, r5.w, l(0x00000000), r18.xyzw
                                                                u2_CollideShapes__collisionVelocities[r5.w].w[(0x00000000u) / 4u + 0u] = r18.x;
                                                                u2_CollideShapes__collisionVelocities[r5.w].w[(0x00000000u) / 4u + 1u] = r18.y;
                                                                u2_CollideShapes__collisionVelocities[r5.w].w[(0x00000000u) / 4u + 2u] = r18.z;
                                                                u2_CollideShapes__collisionVelocities[r5.w].w[(0x00000000u) / 4u + 3u] = r18.w;
                                                                // iadd r6.z, r6.z, l(0x00000001)
                                                                r6.z = (r6.z + 0x00000001u);
                                                                // endif
                                                            }
                                                            // endif
                                                        }
                                                        // endif
                                                    }
                                                    // endif
                                                }
                                                // endif
                                            }
                                            // endif
                                        }
                                        // endif
                                    }
                                    // endif
                                }
                                // endif
                            }
                            // endif
                        }
                        // mov r7.z, r8.y
                        r7.z = r8.y;
                        // else
                    } else {
                        // and r4.w, r16.w, l(0x7fffffff)
                        r4.w = (r16.w & 0x7fffffffu);
