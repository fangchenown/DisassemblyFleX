                }
                // endloop
            }
            // mov r1.y, r6.z
            r1.y = r6.z;
            // endif
        }
        // store_structured u0.x, vThreadID.x, l(0x00000000), r1.y
        u0_CollideShapes__collisionCounts[vThreadID.x].w[(0x00000000u) / 4u + 0u] = r1.y;
