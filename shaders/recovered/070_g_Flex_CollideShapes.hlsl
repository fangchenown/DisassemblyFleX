                        x0[r8.y + 0].x = r15.x;
                        // iadd r5.w, r7.z, l(0x00000001)
                        r5.w = (r7.z + 0x00000001u);
                        // mov x0[r7.z + 0].x, r4.w
                        x0[r7.z + 0].x = r4.w;
                        // mov r7.z, r5.w
                        r7.z = r5.w;
